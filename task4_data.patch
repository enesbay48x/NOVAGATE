 const MAX_DRONES := 10
 
+# Droid fiyati: AYNI turden kacinci droid alindigina gore (sunucu server_db.py drone_price ile ayni).
+const DRONE_PRICES := {
+	"flax": ["cr", [100000, 200000, 400000, 800000, 1600000, 3200000, 6400000, 12800000, 20000000, 20000000]],
+	"iris": ["uri", [15000, 24000, 42000, 60000, 84000, 96000, 126000, 200000, 375000, 589000]],
+}
+const SELL_RATE := 0.4
+
+
+# owned = o turden sahip olunan adet, n = alinacak adet -> [cr, uri]; limit asilirsa [-1, -1]
+static func drone_price(id: String, owned: int, n: int) -> Array:
+	var seq: Array = DRONE_PRICES[id][1]
+	if owned < 0 or owned + n > seq.size():
+		return [-1, -1]
+	var tot := 0
+	for i in range(owned, owned + n):
+		tot += int(seq[i])
+	return [tot, 0] if str(DRONE_PRICES[id][0]) == "cr" else [0, tot]
+
 
