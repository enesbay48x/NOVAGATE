+# ------------------------------------------------------------------ BENI HATIRLA
+func _remember_key() -> String:
+	return "ng-remember|" + OS.get_unique_id() + "|" + OS.get_user_data_dir()
+
+
+func _remember_save(nm: String, pw: String) -> void:
+	var f := FileAccess.open_encrypted_with_pass(REMEMBER_PATH, FileAccess.WRITE, _remember_key())
+	if f == null:
+		return
+	f.store_string(JSON.stringify({"u": nm, "p": pw}))
+	f.close()
+
+
+func _remember_load() -> Dictionary:
+	if not FileAccess.file_exists(REMEMBER_PATH):
+		return {}
+	var f := FileAccess.open_encrypted_with_pass(REMEMBER_PATH, FileAccess.READ, _remember_key())
+	if f == null:
+		return {}   # anahtar uymuyor / dosya bozuk -> hatirlama yok
+	var d = JSON.parse_string(f.get_as_text())
+	f.close()
+	if typeof(d) == TYPE_DICTIONARY and str(d.get("u", "")) != "" and str(d.get("p", "")) != "":
+		return d
+	return {}
+
+
+func _remember_clear() -> void:
+	if FileAccess.file_exists(REMEMBER_PATH):
+		DirAccess.remove_absolute(ProjectSettings.globalize_path(REMEMBER_PATH))
+
+
+# Menu acilinca kayitli bilgi varsa alanlari doldurup otomatik giris yapar.
+func _remember_autologin() -> void:
+	var d: Dictionary = _remember_load()
+	if d.is_empty():
+		return
+	le_user.text = str(d["u"])
+	le_pass.text = str(d["p"])
+	chk_remember.button_pressed = true
+	await get_tree().create_timer(0.6).timeout   # Net / HTTP istegi hazir olsun
+	if auth_register or not is_instance_valid(le_user):
+		return
+	_autologin_active = true
+	_auth_submit()
+
+
+
 func _auth_toggle_mode() -> void:
 	_auth_set_mode(not auth_register)
 
